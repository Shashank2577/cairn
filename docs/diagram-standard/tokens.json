{
  "$schema": "cairn-diagram-tokens/1",
  "version": "1.0.0",
  "notes": "One source for every Cairn diagram: the Map UI, the docs export and hand-made diagrams. Colour roles, not colours, are the contract; values may change, roles may not. Paper and ink match the Cairn UI (src/cairn/ui/styles/tokens.css).",
  "font": {
    "name": "Overpass, 'Helvetica Neue', Arial, sans-serif",
    "tech": "'Overpass Mono', 'SF Mono', Menlo, Consolas, monospace",
    "sizes": {
      "title": 15,
      "name": 13,
      "tech": 10.5,
      "desc": 11,
      "type_tag": 8.5,
      "label": 10.5,
      "label_tech": 9.5,
      "legend": 10,
      "index": 9
    },
    "weights": {
      "title": 700,
      "name": 650,
      "type_tag": 700,
      "label": 500
    },
    "min_rendered_px": 7.5
  },
  "grid": {
    "unit": 4,
    "node_width": 200,
    "node_min_height": 84,
    "col_gap": 120,
    "row_gap": 56,
    "padding": 12,
    "boundary_inset": 20,
    "label_gap": 8,
    "fan_min_gap": 12
  },
  "stroke": {
    "node": 1.2,
    "boundary": 1,
    "line": 1.2,
    "focus": 1.8
  },
  "radius": {
    "node": 6,
    "tag": 2,
    "boundary": 8
  },
  "dash": {
    "async": "5 4",
    "build": "1.5 3.5",
    "external": "4 3",
    "boundary": "6 4",
    "return": "4 3"
  },
  "budget": {
    "nodes_soft": 12,
    "nodes_hand_made": 9,
    "relationships": 16,
    "accents": 2,
    "boundaries": 3,
    "sequence_participants": 6,
    "sequence_messages": 12,
    "sequence_fragments": 1,
    "label_what_chars": 32,
    "label_how_chars": 36,
    "accents_min": 0
  },
  "themes": {
    "light": {
      "paper": "#F4F5F0",
      "sheet": "#FBFBF8",
      "ink": "#1F2328",
      "ink2": "#464B45",
      "muted": "#6B7068",
      "rule": "#C6C9BD",
      "faint": "#E9EAE3",
      "node_fill": "#FFFFFF",
      "node_stroke": "#1F2328",
      "store_fill": "#EEEFE9",
      "channel_fill": "#EEEFE9",
      "external_fill": "#F4F5F0",
      "external_stroke": "#767B72",
      "person_fill": "#FFFFFF",
      "boundary_fill": "rgba(31,35,40,0.025)",
      "boundary_stroke": "#767B72",
      "accent": "#B4531C",
      "accent_wash": "#F6E6DA",
      "line": "#464B45",
      "label_mask": "#F4F5F0",
      "trust": "#2F6FA3",
      "sensitive": "#8A3FA0",
      "inferred": "#6B7068",
      "stale": "#B8433A",
      "stale_wash": "#F5E3E0"
    },
    "dark": {
      "paper": "#141815",
      "sheet": "#1A1F1B",
      "ink": "#E8EBE3",
      "ink2": "#C3C8BE",
      "muted": "#9AA096",
      "rule": "#3A403A",
      "faint": "#232823",
      "node_fill": "#1C211D",
      "node_stroke": "#E8EBE3",
      "store_fill": "#232823",
      "channel_fill": "#232823",
      "external_fill": "#171B18",
      "external_stroke": "#7E847A",
      "person_fill": "#1C211D",
      "boundary_fill": "rgba(232,235,227,0.03)",
      "boundary_stroke": "#7E847A",
      "accent": "#F08A4B",
      "accent_wash": "#3A2618",
      "line": "#C3C8BE",
      "label_mask": "#141815",
      "trust": "#72AADA",
      "sensitive": "#C58AD6",
      "inferred": "#9AA096",
      "stale": "#E0796F",
      "stale_wash": "#3A201D"
    }
  },
  "element_types": {
    "person": {
      "shape": "person",
      "fill": "person_fill",
      "stroke": "node_stroke",
      "border": "solid",
      "levels": [
        "landscape",
        "context",
        "container",
        "component",
        "flow"
      ]
    },
    "system": {
      "shape": "box",
      "fill": "node_fill",
      "stroke": "node_stroke",
      "border": "solid",
      "levels": [
        "landscape",
        "context",
        "container",
        "component",
        "flow"
      ]
    },
    "external-system": {
      "shape": "box",
      "fill": "external_fill",
      "stroke": "external_stroke",
      "border": "external",
      "levels": [
        "landscape",
        "context",
        "container",
        "component",
        "flow"
      ]
    },
    "container": {
      "shape": "box",
      "fill": "node_fill",
      "stroke": "node_stroke",
      "border": "solid",
      "levels": [
        "container",
        "component",
        "flow"
      ],
      "requires_tech": true,
      "kinds": [
        "web-app",
        "service",
        "worker",
        "cli",
        "job",
        "mobile-app",
        "desktop-app",
        "function"
      ]
    },
    "data-store": {
      "shape": "cylinder",
      "fill": "store_fill",
      "stroke": "node_stroke",
      "border": "solid",
      "levels": [
        "container",
        "component",
        "flow"
      ],
      "requires_tech": true
    },
    "channel": {
      "shape": "pipe",
      "fill": "channel_fill",
      "stroke": "node_stroke",
      "border": "solid",
      "levels": [
        "container",
        "component",
        "flow"
      ],
      "requires_tech": true
    },
    "library": {
      "shape": "library",
      "fill": "node_fill",
      "stroke": "node_stroke",
      "border": "solid",
      "levels": [
        "container",
        "component"
      ],
      "requires_tech": true
    },
    "component": {
      "shape": "component",
      "fill": "node_fill",
      "stroke": "node_stroke",
      "border": "solid",
      "levels": [
        "component",
        "flow"
      ],
      "requires_tech": true
    },
    "code": {
      "shape": "compartment",
      "fill": "node_fill",
      "stroke": "node_stroke",
      "border": "solid",
      "levels": [
        "code",
        "data-model"
      ]
    },
    "entity": {
      "shape": "compartment",
      "fill": "node_fill",
      "stroke": "node_stroke",
      "border": "solid",
      "levels": [
        "data-model"
      ]
    },
    "state": {
      "shape": "pill",
      "fill": "node_fill",
      "stroke": "node_stroke",
      "border": "solid",
      "levels": [
        "state"
      ]
    }
  },
  "diagram_kinds": {
    "landscape": {
      "title_prefix": "System landscape",
      "primary": [
        "system",
        "external-system",
        "person"
      ],
      "how": "optional"
    },
    "context": {
      "title_prefix": "System context",
      "primary": [
        "system"
      ],
      "supporting": [
        "person",
        "external-system"
      ],
      "how": "forbidden"
    },
    "container": {
      "title_prefix": "Containers",
      "primary": [
        "container",
        "data-store",
        "channel",
        "library"
      ],
      "supporting": [
        "person",
        "system",
        "external-system"
      ],
      "how": "required"
    },
    "component": {
      "title_prefix": "Components",
      "primary": [
        "component"
      ],
      "supporting": [
        "container",
        "data-store",
        "channel",
        "library",
        "person",
        "system",
        "external-system"
      ],
      "how": "required"
    },
    "flow": {
      "title_prefix": "Flow",
      "style": "sequence",
      "how": "required"
    },
    "code": {
      "title_prefix": "Code",
      "primary": [
        "code"
      ],
      "how": "optional"
    },
    "data-model": {
      "title_prefix": "Data model",
      "primary": [
        "entity"
      ],
      "how": "forbidden"
    },
    "state": {
      "title_prefix": "Lifecycle",
      "primary": [
        "state"
      ],
      "how": "forbidden"
    }
  },
  "relationship_styles": {
    "sync": {
      "dash": null,
      "head": "filled",
      "legend": "Synchronous request"
    },
    "async": {
      "dash": "async",
      "head": "open",
      "legend": "Asynchronous message"
    },
    "build": {
      "dash": "build",
      "head": "open",
      "legend": "Build-time dependency"
    },
    "return": {
      "dash": "return",
      "head": "filled",
      "legend": "Reply (flows only)"
    }
  },
  "provenance": {
    "extracted": {
      "mark": "",
      "legend": "Read directly from code, manifest or deploy file"
    },
    "declared": {
      "mark": "◆",
      "legend": "Declared by a person (system.yaml or a hand-made source)"
    },
    "inferred": {
      "mark": "≈",
      "legend": "Derived; verify before relying on it"
    },
    "ambiguous": {
      "mark": "?",
      "legend": "More than one candidate; see evidence"
    },
    "stale": {
      "mark": "⚠",
      "legend": "Evidence no longer found at the last sync"
    }
  },
  "overlays": {
    "data-class": {
      "values": [
        "public",
        "internal",
        "personal",
        "sensitive"
      ],
      "color": "sensitive",
      "legend": "Data classification carried by the relationship"
    },
    "trust-boundary": {
      "color": "trust",
      "legend": "Boundary with a security control (authentication, network isolation)"
    }
  }
}